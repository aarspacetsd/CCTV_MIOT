# ===========================================
# DEPENDENCIES
# ===========================================
/node_modules
/vendor

# ===========================================
# BUILD OUTPUT (handled by Docker multi-stage)
# ===========================================
/public/build
/public/hot
/public/css
/public/js

# ===========================================
# ENVIRONMENT & SECRETS
# ===========================================
.env
.env.backup
.env.production
.env.staging
/storage/*.key

# ===========================================
# STORAGE (keep structure, ignore contents)
# ===========================================
/public/storage
/storage/app/public/*
!storage/app/public/.gitignore

/storage/framework/cache/data/*
!storage/framework/cache/data/.gitkeep

/storage/framework/sessions/*
!storage/framework/sessions/.gitkeep

/storage/framework/views/*
!storage/framework/views/.gitkeep

/storage/logs/*
!storage/logs/.gitkeep

# ===========================================
# CACHE & TESTING
# ===========================================
/.phpunit.cache
.phpunit.result.cache
/bootstrap/cache/*.php

# ===========================================
# DOCKER
# ===========================================
docker-compose.override.yml
/docker_backup_2025-12-29_03-58-50/

# ===========================================
# LOGS
# ===========================================
npm-debug.log
yarn-error.log
*.log

# ===========================================
# IDE & OS
# ===========================================
/.fleet
/.idea
/.vscode
.DS_Store
Thumbs.db

# ===========================================
# LARAVEL LEGACY
# ===========================================
Homestead.json
Homestead.yaml

# ===========================================
# KEEP PUBLIC ASSETS
# ===========================================
!/public/assets
!/public/assets/**
